{
  "info": {
    "_postman_id": "e268ca9a-0648-4000-95a4-09ad01d8e765",
    "name": "CDISC Library SDTM API",
    "description": "The CDISC Library API is a REST API that delivers CDISC standards metadata to software applications that automate standards-based processes. It uses linked data to provide access to SDTM, ADaM, and other clinical data standards. Responses are available in JSON, XML, ODM, CSV, and Excel formats. Access requires a CDISC Library account and an API key obtained from the CDISC Library API Management (APIM) Developer Portal.\n\nContact Support:\n Name: CDISC Library Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:46:42.000Z",
    "updatedAt": "2026-10-21T20:46:42.000Z",
