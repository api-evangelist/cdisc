{
  "opencollection": "1.0.0",
  "info": {
    "name": "CDISC Library ADaM CDASH API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "CDASH",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all CDASH standard versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://library.cdisc.org/api/mdr/cdash"
          },
          "docs": "Returns all published versions of the CDASH standard."
        }
      ]
    }
  ],
  "bundled": true
}